# Django Settings
DJANGO_ENVIRONMENT=production
SECRET_KEY=your-secret-key-here-change-this-to-random-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (Production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI API keys
# Required for question generation and audio transcription.
GROQ_API_KEY=your-groq-api-key
# Optional Groq model override for question generation.
GROQ_QUESTION_MODEL=openai/gpt-oss-20b
# Required only to evaluate a submitted answer and for resume parsing.
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Cloud Text-to-Speech (Neural2)
# Enable the Cloud Text-to-Speech API, then provide a service account with the
# Cloud Text-to-Speech User role. Use one credential option:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_TTS_ENABLED=true
GOOGLE_TTS_VOICE=en-IN-Neural2-A
GOOGLE_TTS_LANGUAGE_CODE=en-IN

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
